---
layout: v3.njk
---
{#- Category / region ranking page. Design: design/Category Page V3 - Identity Verification (Desktop).dc.html
    Blocks without data are not rendered. -#}
{%- set ev = site.v3.evidence -%}
<div class="container">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li><li class="sep" aria-hidden="true">›</li>
      <li aria-current="page">{{ c.breadcrumb_label }}</li>
    </ol>
  </nav>

  <section class="cat-hero" aria-labelledby="h1">
    <h1 id="h1" class="h-display">{{ c.seo.h1 }}</h1>
    {%- if c.quick_answer %}<p class="quick-answer">{{ c.quick_answer }}</p>{% endif %}
    <div class="byline">
      {%- if author %}
      <div class="byline__author"><img class="avatar" src="{{ author.photo }}" alt=""><span>By {% if author.url %}<a href="{{ author.url }}">{{ author.name }}</a>{% else %}<strong class="fw-500 c-ink">{{ author.name }}</strong>{% endif %}</span></div>
      {%- endif %}
      {%- if c.last_verified %}{% if author %}<span class="dot" aria-hidden="true">·</span>{% endif %}<span><span class="tick" aria-hidden="true">✓</span> Last verified <time datetime="{{ c.last_verified }}">{{ c.last_verified | displayDate }}</time></span>{% endif %}
      {%- if c.updated and c.updated > c.last_verified %}<span class="dot" aria-hidden="true">·</span><span>Updated <time datetime="{{ c.updated }}">{{ c.updated | displayDate }}</time></span>{% endif %}
    </div>
  </section>

  {%- if entries.length %}
  <nav class="jump" aria-label="Jump to provider">
    {%- for e in entries %}<a href="#rank-{{ e.rank }}"><b>{{ e.rank | pad2 }}</b>{{ e.r.name }}</a>{% endfor %}
  </nav>

  <div class="card table-scroll">
    <table class="rank-table">
      <caption>{{ c.breadcrumb_label }}: providers ranked by BeVerified, with starting price and what each is best for.</caption>
      <thead><tr><th scope="col">Rank</th><th scope="col">Provider</th><th scope="col">Score</th><th scope="col" class="hide-sm">Starting price</th><th scope="col" class="hide-sm">Best for</th><th scope="col"><span class="visually-hidden">Review</span></th></tr></thead>
      <tbody>
      {%- for e in entries %}
        <tr>
          <td class="num">{{ e.rank }}</td>
          <th class="fw-500 ta-left" scope="row"><span class="rank-table__prov">{% if e.q and e.q.logo.wordmark %}<img class="wordmark wordmark--sm h-18 maxw-80" src="{{ e.q.logo.wordmark }}" alt="">{% endif %}{{ e.r.name }}{% if e.rank == 1 %} <span class="pill pill--dark fs-12 p-1-8">◆ {{ e.r.award or "Top pick" }}</span>{% endif %}</span></th>
          <td class="num">{% if e.q and e.q.score != null %}<strong>{{ e.q.score | score1 }}</strong> <span class="c-muted">/ 5</span>{% else %}<span class="c-muted fs-14">Not reviewed</span>{% endif %}</td>
          <td class="hide-sm">{{ e.r.legacy_price_shown or "Not listed" }}</td>
          <td class="hide-sm c-body">{% if e.rank > 1 %}{{ e.r.award }}{% endif %}</td>
          <td>{% if e.q %}<a href="/providers/{{ e.q.slug }}/">Read review →</a>{% else %}<span class="c-muted fs-14">Review coming</span>{% endif %}</td>
        </tr>
      {%- endfor %}
      </tbody>
    </table>
  </div>
  {%- endif %}

  <main id="main" class="cat-main">
    {%- if entries.length %}
    <section aria-label="Ranked providers">
      <p class="disclosure-line">{{ site.v3.disclosure }} <a href="{{ site.v3.disclosureHref }}">How we make money →</a></p>
      <ol class="stack list-none p-0">
      {%- for e in entries %}
        <li>
        <article id="rank-{{ e.rank }}" class="card rank-card{% if e.rank == 1 %} rank-card--top{% endif %}">
          <div class="rank-card__num">{{ e.rank | pad2 }}</div>
          <div class="rank-card__body">
            {%- if e.r.award %}<span class="pill{% if e.rank == 1 %} pill--dark{% endif %}">{% if e.rank == 1 %}◆ {% endif %}{{ e.r.award }}</span>{% endif %}
            <h2 class="rank-card__name">{% if e.q and e.q.logo.wordmark %}<img class="wordmark wordmark--sm h-24" src="{{ e.q.logo.wordmark }}" alt="">{% endif %}{{ e.r.name }}</h2>
            {%- if e.r.tagline %}<p class="rank-card__tagline">{{ e.r.tagline }}</p>{% endif %}
            {%- if e.r.coverage or e.r.size %}
            <div class="rank-card__meta">{% if e.r.coverage %}<span>Coverage <b>{{ e.r.coverage }}</b></span>{% endif %}{% if e.r.size %}<span>Fits <b>{{ e.r.size }}</b></span>{% endif %}</div>
            {%- endif %}
            {%- if e.r.pros.length or e.r.cons.length %}
            <div class="rank-card__pc">
              <div><h3>+ Pros</h3><ul>{% for t in e.r.pros %}<li>{{ t }}</li>{% endfor %}</ul></div>
              <div><h3>− Cons</h3><ul>{% for t in e.r.cons %}<li>{{ t }}</li>{% endfor %}</ul></div>
            </div>
            {%- endif %}
          </div>
          <div class="rank-card__score">
            {%- if e.q and e.q.score != null %}
            <div role="img" aria-label="{{ e.q.score | score1 }} out of 5"><span class="num-big">{{ e.q.score | score1 }}</span> <span class="c-muted">/ 5</span></div>
            <div class="meter" aria-hidden="true">{% for w in (e.q.score | meter) %}<span><i class="w-{{ w }}"></i></span>{% endfor %}</div>
            {%- else %}<span class="pill">Review coming</span>{% endif %}
          </div>
          <div class="rank-card__foot">
            {%- if e.r.legacy_price_shown %}<span>From <strong>{{ e.r.legacy_price_shown }}</strong></span>{% endif %}
            <span class="spacer"></span>
            {%- if e.q %}<a class="btn btn--secondary btn--sm" href="/providers/{{ e.q.slug }}/">Read full review</a>{% endif %}
            {%- if e.q and e.q.link.url %}<a class="btn btn--primary btn--sm" href="{{ e.q.link.url }}" rel="{{ e.q.link | outRel }}" target="_blank">Visit site ↗</a>{% if (e.q.link.type == "paid" or e.q.link.type == "affiliate") and e.q.link.label != false %}<span class="paid-note">Sponsored link</span>{% endif %}{% endif %}
          </div>
        </article>
        </li>
      {%- endfor %}
      </ol>
    </section>
    {%- endif %}

    {%- if matrix %}
    <section aria-labelledby="cap-h">
      <h2 id="cap-h" class="h-section">Capabilities compared</h2>
      <p class="cap-legend">Checked against each provider's own pages{% if matrix.checked %}, {{ matrix.checked | displayDate }}{% endif %}. <span><i class="cap-dot cap-dot--full" aria-hidden="true"></i>in the core product</span> <span><i class="cap-dot cap-dot--half" aria-hidden="true"></i>add-on module or higher plan</span> <span><i class="cap-dot cap-dot--empty" aria-hidden="true"></i>not offered</span> <span><i class="cap-dot cap-dot--unknown" aria-hidden="true"></i>not disclosed</span>. Numbers link to the source on each review.</p>
      <div class="card cap-matrix">
        <div class="cap-matrix__scroll" role="region" aria-label="Capability matrix, scrolls sideways" tabindex="0">
          <table class="cap-table">
            <caption class="visually-hidden">{{ c.breadcrumb_label }}: capabilities of each ranked provider, with sources.</caption>
            <thead><tr><th scope="col">Provider</th>{% for col in matrix.cols %}<th scope="col">{{ col.label }}</th>{% endfor %}</tr></thead>
            <tbody>
            {%- for row in matrix.rows %}
              <tr>
                <th scope="row"><a href="/providers/{{ row.slug }}/">{{ row.name }}</a></th>
                {%- for cell in row.cells %}
                <td>{% if cell.sym %}<i class="cap-dot cap-dot--{{ cell.sym }}" aria-hidden="true"></i>{% endif %}{{ cell.label }}{% if cell.source %} <a class="src-ref--inline fs-12" href="/providers/{{ row.slug }}/#src-{{ cell.source }}" aria-label="{{ row.name }} source {{ cell.source }}">[{{ cell.source }}]</a>{% endif %}{% if cell.note %}<small>{{ cell.note }}</small>{% endif %}</td>
                {%- endfor %}
              </tr>
            {%- endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </section>
    {%- endif %}

    <section aria-labelledby="how-h">
      <h2 id="how-h" class="h-section">How we ranked this category</h2>
      <div class="card weights">
        <div>
          {%- for r in site.v3.rubric %}<div class="weights__row"><span>{{ r.name }}</span><span class="bar" aria-hidden="true"><i class="w-{{ r.weight * 4 }}"></i></span><span>{{ r.weight }}%</span></div>{% endfor %}
          <p class="mt-12 fs-14"><a href="{{ site.v3.methodologyHref }}">Full methodology {{ site.v3.methodologyVersion }} →</a></p>
        </div>
        <div class="weights__key">
          <span>Evidence levels we rely on</span>
          {%- for k, e in ev %}<span><span class="evidence evidence--sm"><span aria-hidden="true">{{ e.icon }}</span>{{ e.label }}</span> {{ e.desc }}</span>{% endfor %}
        </div>
      </div>
    </section>

    {%- for h in c.explainer_html %}
    <section class="legacy-prose">{{ h | cleanHtml | safe }}</section>
    {%- endfor %}

    {%- set reading = collections.articles | articlesAbout("categories", c.slug, 3) %}
    {%- if reading.length %}
    <section aria-labelledby="rd-h">
      <h2 id="rd-h" class="h-section">Guides and news</h2>
      <div class="grid-3">{% for a in reading %}{% include "v3/post-card.njk" %}{% endfor %}</div>
    </section>
    {%- endif %}
    {%- if c.faq and c.faq.length %}
    <section class="maxw-760" aria-labelledby="faq-h">
      <h2 id="faq-h" class="h-section mb-12">FAQ</h2>
      <div class="faq">{% for f in c.faq %}<details{% if loop.first %} open{% endif %}><summary><h3>{{ f.q }}</h3></summary><p>{{ f.a }}</p></details>{% endfor %}</div>
    </section>
    {%- endif %}

    {%- if related.length %}
    <section aria-labelledby="rel-h">
      <div class="section-head mb-20"><h2 id="rel-h" class="h-section m-0">Related categories</h2><a class="fs-15 fw-500" href="/providers/">Browse all providers →</a></div>
      <div class="grid-4">{% for r in related %}<a class="card cat-card" href="{{ r.url }}"><b>{{ r.name }}</b><span>See all {{ r.count }} providers →</span></a>{% endfor %}</div>
    </section>
    {%- endif %}
  </main>
</div>
