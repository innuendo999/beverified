<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ seoTitle }}</title>
{%- if seoDescription %}
<meta name="description" content="{{ seoDescription }}">
{%- endif %}
{%- if noindex %}
<meta name="robots" content="noindex">
{%- else %}
<meta name="robots" content="max-image-preview:large">
{%- endif %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:title" content="{{ seoTitle }}">
{%- if seoDescription %}
<meta property="og:description" content="{{ seoDescription }}">
{%- endif %}
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:site_name" content="BeVerified">
<meta property="og:image" content="{{ site.url }}{{ ogImage or '/assets/brand/og-default.png' }}">
<meta property="og:image:width" content="{{ ogImageSize[0] if ogImageSize else 1200 }}">
<meta property="og:image:height" content="{{ ogImageSize[1] if ogImageSize else 630 }}">
<meta property="og:image:alt" content="{{ ogImageAlt or 'BeVerified: independent reviews of KYC, KYB and AML providers' }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="/assets/brand/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png">
<link rel="manifest" href="/assets/brand/site.webmanifest">
<meta name="theme-color" content="#F7F6F3">
<link rel="preload" href="/assets/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ '/assets/css/v3.css' | assetVersion }}">
{%- if jsonld %}
<script type="application/ld+json">{{ jsonld | json | safe }}</script>
{%- endif %}
</head>
<body>
<a class="skip-link" href="#main">Skip to main content</a>
{% include "v3/header.njk" %}
{{ content | safe }}
{% include "v3/footer.njk" %}
{% include "v3/consent.njk" %}
<script>
(function () {
  var h = document.querySelector('.site-header'), b = document.querySelector('.nav-toggle');
  if (h && b) b.addEventListener('click', function () {
    var open = h.classList.toggle('is-open'); b.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  // Mega menu: click or hover opens a panel, Escape or a click outside closes it.
  // Without this script the panels still open on hover and keyboard focus (CSS).
  var items = h ? [].slice.call(h.querySelectorAll('[data-mm-item]')) : [];
  if (items.length) {
    document.documentElement.classList.add('mm-js');
    var desk = window.matchMedia('(min-width: 861px) and (hover: hover)'), timer;
    var set = function (item, open) {
      item.classList.toggle('is-open', open);
      item.querySelector('.mm-top').setAttribute('aria-expanded', open ? 'true' : 'false');
    };
    var only = function (item) { items.forEach(function (i) { set(i, i === item); }); };
    var closeAll = function () { only(null); };
    items.forEach(function (item) {
      var btn = item.querySelector('.mm-top');
      btn.addEventListener('click', function () { item.classList.contains('is-open') ? set(item, false) : only(item); });
      item.addEventListener('mouseenter', function () {
        if (!desk.matches) return;
        clearTimeout(timer); timer = setTimeout(function () { only(item); }, 70);
      });
      // Ranking preview follows the hovered or focused category
      item.querySelectorAll('[data-mm-cat]').forEach(function (row) {
        var show = function () {
          var id = row.getAttribute('data-mm-cat');
          item.querySelectorAll('[data-mm-cat]').forEach(function (r) { r.classList.toggle('is-on', r === row); });
          item.querySelectorAll('[data-mm-pv]').forEach(function (pv) { pv.classList.toggle('is-on', pv.getAttribute('data-mm-pv') === id); });
        };
        row.addEventListener('mouseenter', show); row.addEventListener('focus', show);
      });
    });
    h.addEventListener('mouseleave', function () {
      if (!desk.matches) return;
      clearTimeout(timer); timer = setTimeout(closeAll, 180);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      var open = items.filter(function (i) { return i.classList.contains('is-open'); })[0];
      if (open) { closeAll(); open.querySelector('.mm-top').focus(); }
    });
    document.addEventListener('click', function (e) { if (!h.contains(e.target)) closeAll(); });
  }
  // Open a collapsed list (sources, certifications) when a footnote link points into it.
  function reveal(id) {
    var el = id && document.getElementById(id), d = el && el.closest('details');
    if (d && !d.open) { d.open = true; el.scrollIntoView(); }
  }
  reveal(location.hash.slice(1));
  window.addEventListener('hashchange', function () { reveal(location.hash.slice(1)); });
  document.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('a[href^="#src-"]');
    if (a) reveal(a.getAttribute('href').slice(1));
  });
})();
</script>
</body>
</html>
