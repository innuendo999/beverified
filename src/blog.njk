---
layout: v3.njk
navCurrent: blog
pagination:
  data: blogArchives
  size: 1
  alias: arc
  addAllPagesToCollections: true
permalink: "{{ arc.url }}"
eleventyComputed:
  seoTitle: "{{ arc.seoTitle }}"
  seoDescription: "{{ arc.seoDescription }}"
---
{#- Blog index and section archives (old WordPress /category/<section>/ URLs). Design: design/Blog Index V3 (Desktop).dc.html -#}
{%- set list = collections.articles | inSection(arc.key) -%}
<main id="main" class="container hub">
  <nav class="breadcrumb" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li class="sep" aria-hidden="true">›</li>{% if arc.key != "all" %}<li><a href="/blog/">Blog</a></li><li class="sep" aria-hidden="true">›</li>{% endif %}<li aria-current="page">{{ arc.crumb }}</li></ol></nav>
  <header class="text-hero pb-24">
    <h1 class="h-display">{{ arc.h1 }}</h1>
    <p>{{ arc.lede }}</p>
  </header>
  <nav class="dir__tabs" aria-label="Sections">{% for t in blogArchives %}<a href="{{ t.url }}"{% if t.key == arc.key %} aria-current="page"{% endif %}>{{ t.tab }}</a>{% endfor %}</nav>
  {%- if list.length %}
  <div class="grid-3 post-grid">{% for a in list %}{% include "v3/post-card.njk" %}{% endfor %}</div>
  {%- else %}<p class="hub__note">No posts in this section yet.</p>{% endif %}
</main>
