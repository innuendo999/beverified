<path d="M220 150 L220 170" stroke="var(--muted)" stroke-width="2" marker-end="url(#fsc-a)"/>
<rect x="1" y="172" width="438" height="62" rx="12" fill="var(--surface)" stroke="var(--line-strong)" stroke-width="1.5"/><circle cx="33" cy="203" r="17" fill="var(--ink)"/><text x="33" y="209" text-anchor="middle" font-size="17" font-weight="700" fill="var(--surface)">3</text><text x="62" y="199" font-size="18" font-weight="600" fill="var(--ink)">Screen every OFAC list</text><text x="62" y="222" font-size="15" fill="var(--muted)">SDN, non-SDN, 50 Percent Rule</text>
<path d="M220 234 L220 254" stroke="var(--muted)" stroke-width="2" marker-end="url(#fsc-a)"/>
<rect x="1" y="256" width="438" height="62" rx="12" fill="var(--surface)" stroke="var(--line-strong)" stroke-width="1.5"/><circle cx="33" cy="287" r="17" fill="var(--ink)"/><text x="33" y="293" text-anchor="middle" font-size="17" font-weight="700" fill="var(--surface)">4</text><text x="62" y="283" font-size="18" font-weight="600" fill="var(--ink)">Screen at the right moments</text><text x="62" y="306" font-size="15" fill="var(--muted)">onboarding, payments, list changes</text>
<path d="M220 318 L220 338" stroke="var(--muted)" stroke-width="2" marker-end="url(#fsc-a)"/>
<rect x="1" y="340" width="438" height="62" rx="12" fill="var(--surface)" stroke="var(--line-strong)" stroke-width="1.5"/><circle cx="33" cy="371" r="17" fill="var(--ink)"/><text x="33" y="377" text-anchor="middle" font-size="17" font-weight="700" fill="var(--surface)">5</text><text x="62" y="367" font-size="18" font-weight="600" fill="var(--ink)">Review alerts</text><text x="62" y="390" font-size="15" fill="var(--muted)">check identifiers, escalate</text>
<path d="M220 402 L220 422" stroke="var(--muted)" stroke-width="2" marker-end="url(#fsc-a)"/>
<text x="1" y="440" font-size="16" font-weight="700" fill="var(--accent)">6. Confirmed match</text>
<rect x="1" y="452" width="208" height="72" rx="12" fill="var(--accent-soft)" stroke="var(--accent)" stroke-width="2"/><text x="105" y="481" text-anchor="middle" font-size="18" font-weight="700" fill="var(--ink)">Block</text><text x="105" y="506" text-anchor="middle" font-size="15" fill="var(--muted)">e.g. an SDN</text>
<rect x="231" y="452" width="208" height="72" rx="12" fill="var(--surface)" stroke="var(--accent)" stroke-width="2"/><text x="335" y="481" text-anchor="middle" font-size="18" font-weight="700" fill="var(--ink)">Reject</text><text x="335" y="506" text-anchor="middle" font-size="15" fill="var(--muted)">prohibited, nothing to block</text>
