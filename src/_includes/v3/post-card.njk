{#- With a cover: image, title, date only (the cover already carries the section and topic). Without a cover: section pill, lede and topic chips. -#}
{%- set d = a.data.published or a.data.updated -%}
{%- if a.data.cover -%}
<a class="card post-card post-card--cover" href="{{ a.url }}"><img class="post-card__cover" src="{{ a.data.cover }}" alt="" width="1600" height="900" loading="lazy" decoding="async" style="height:auto"><b>{{ a.data.title }}</b><span class="post-card__date">{% if d %}<time datetime="{{ d | iso }}">{{ d | displayDate }}</time>{% endif %}</span></a>
{%- else -%}
<a class="card post-card" href="{{ a.url }}"><span class="pill self-start">{{ a.data.section | sectionLabel }}</span><b>{{ a.data.title }}</b><p>{{ a.data.lede }}</p>{% if a.data.topics.length %}<span class="post-card__chips">{% for t in a.data.topics %}{% if loop.index <= 3 %}<span class="chip"># {{ t }}</span>{% endif %}{% endfor %}</span>{% endif %}<span class="post-card__foot">{{ a.data.au.name if a.data.au else "BeVerified" }} · {{ d | displayDate }}</span></a>
{%- endif %}
