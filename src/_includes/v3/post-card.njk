<a class="card post-card{% if a.data.cover %} post-card--cover{% endif %}" href="{{ a.url }}">{% if a.data.cover %}<img class="post-card__cover" src="{{ a.data.cover }}" alt="" width="1600" height="900" loading="lazy" decoding="async" style="height:auto">{% endif %}<span class="pill self-start">{{ a.data.section | sectionLabel }}</span><b>{{ a.data.title }}</b><p>{{ a.data.lede }}</p>{% if a.data.topics.length %}<span class="post-card__chips">{% for t in a.data.topics %}{% if loop.index <= 3 %}<span class="chip"># {{ t }}</span>{% endif %}{% endfor %}</span>{% endif %}<span class="post-card__foot">{{ a.data.au.name if a.data.au else "BeVerified" }} · {{ (a.data.published or a.data.updated) | displayDate }}</span></a>