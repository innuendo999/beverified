<a class="card post-card" href="{{ a.url }}"><span class="pill" style="align-self:flex-start">{{ a.data.section | sectionLabel }}</span><b>{{ a.data.title }}</b><p>{{ a.data.lede }}</p>{% if a.data.topics.length %}<span class="post-card__chips">{% for t in a.data.topics %}{% if loop.index <= 3 %}<span class="chip"># {{ t }}</span>{% endif %}{% endfor %}</span>{% endif %}<span class="post-card__foot">{{ a.data.au.name if a.data.au else "BeVerified" }} · {{ (a.data.published or a.data.updated) | displayDate }}</span></a>