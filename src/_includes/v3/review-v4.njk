{#- Review page V4 (owner, 2026-11-10). Canvas: "BeVerified: review page V4", board V4b.
    Included by src/reviews.njk when the provider's profile has v4: true (src/_data/reviewProfiles.yml).
    Data: the provider record (p) + v4 from reviews.11tydata.js (src/_lib/review-v4.js). Empty blocks are not rendered. -#}
{%- set ev = site.v3.evidence -%}
{%- set reading = collections.articles | articlesAbout("providers", p.slug, 3) %}
{%- set sp = v4.sponsor %}

<div class="rv4">
<section class="rv4-hero" aria-labelledby="h1">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li><li class="sep" aria-hidden="true">›</li>
        <li><a href="/providers/">Reviews</a></li><li class="sep" aria-hidden="true">›</li>
        <li aria-current="page">{{ p.name }}</li>
      </ol>
    </nav>
    <div class="rv4-hero__grid">
      <div class="rv4-hero__main">
        <div class="rv4-logo">
          {%- if p.logo.wordmark %}<img src="{{ p.logo.wordmark }}" alt="{{ p.name }} logo">{% else %}<span>{{ p.name }}</span>{% endif %}
        </div>
        {%- if p.rebranded_to %}<p class="rv4-now">now {{ p.rebranded_to }}</p>{% endif %}
        <h1 id="h1" class="rv4-h1">{{ p.name }} Review {{ v4.year }}</h1>
        <div class="rv4-byline">
          {%- if author %}<img class="avatar" src="{{ author.photo }}" alt=""><span>By {% if author.url %}<a href="{{ author.url }}">{{ author.name }}</a>{% else %}{{ author.name }}{% endif %}</span>{% endif %}
          {%- if p.last_verified %}<span class="dot" aria-hidden="true">·</span><span>Last verified <time datetime="{{ p.last_verified }}">{{ p.last_verified | displayDate }}</time></span>{% endif %}
        </div>
        {%- if p.verdict %}<p class="rv4-verdict">{{ p.verdict }}</p>{% endif %}
        {%- if v4.hero.length %}
        <dl class="rv4-facts rv4-facts--{{ v4.hero.length }}">
          {%- for f in v4.hero %}
          <div><dt>{{ f.label }}</dt><dd class="num{% if f.ok %} rv4-ok{% endif %}">{{ f.value }}</dd>{% if f.sub %}<dd class="rv4-sub">{{ f.sub }}</dd>{% endif %}</div>
          {%- endfor %}
        </dl>
        {%- endif %}
      </div>

      <div class="rv4-hero__side">
        {%- if sp %}
        <aside class="rv4-ad" aria-label="Sponsored">
          <p class="rv4-ad__label"><svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="8" cy="8" r="6.5"/><path d="M8 7v4.5M8 4.8v.2"/></svg>Sponsored</p>
          <div class="rv4-ad__row">
            <span class="rv4-ad__logo">{% if sp.provider.logo.wordmark %}<img src="{{ sp.provider.logo.wordmark }}" alt="">{% else %}{{ sp.provider.name }}{% endif %}</span>
            <span class="rv4-ad__text"><a href="/providers/{{ sp.provider.slug }}/">{{ sp.provider.name }}</a><span class="num">{{ sp.provider.score | score1 }} / 5 · #{{ sp.rank }} in {{ sp.category }}</span></span>
            <a class="rv4-ad__btn" href="{{ sp.provider.link.url }}" data-ad target="_blank">Visit site <span aria-hidden="true">↗</span></a>
          </div>
        </aside>
        {%- endif %}
        {%- if p.score != null %}
        <div class="rv4-score">
          <div class="rv4-score__label">BeVerified score</div>
          <div class="rv4-score__value" role="img" aria-label="BeVerified score {{ p.score | score1 }} out of 5{% if p.grade %}, {{ p.grade }}{% endif %}">
            <span class="num" aria-hidden="true">{{ p.score | score1 }}</span><span class="rv4-score__of" aria-hidden="true">/ 5</span>{% if p.grade %}<span class="rv4-score__grade" aria-hidden="true">{{ p.grade }}</span>{% endif %}
          </div>
          <div class="meter" aria-hidden="true">{% for w in (p.score | meter) %}<span><i class="w-{{ w }}"></i></span>{% endfor %}</div>
          {%- if v4.rank %}<p class="rv4-score__rank"><a href="{{ v4.rank.url }}">#{{ v4.rank.pos }} in {{ v4.rank.label }}</a></p>{% endif %}
          {%- if p.link.url %}
          <p class="rv4-score__disc">{{ site.v3.disclosure }} <a href="{{ site.v3.disclosureHref }}">How we make money</a></p>
          {%- if v4.sponsorNote %}<p class="rv4-score__disc">{{ v4.sponsorNote }}</p>{% endif %}
          {%- if v4.button == "primary" %}
          <a class="btn btn--primary btn--block" href="{{ p.link.url }}" rel="{{ p.link | outRel }}" target="_blank">Visit site <span aria-hidden="true">↗</span></a>
          {%- else %}
          <a class="rv4-quiet" href="{{ p.link.url }}" rel="{{ p.link | outRel }}" target="_blank">Official website <span aria-hidden="true">↗</span></a>
          {%- endif %}
          {%- if (p.link.type == "paid" or p.link.type == "affiliate") and p.link.label != false %}<span class="paid-note">Sponsored link</span>{% endif %}
          {%- endif %}
        </div>
        {%- endif %}
      </div>
    </div>
  </div>
</section>

<nav class="rv4-tabs" aria-label="On this page">
  <div class="container">
    {%- if v4.fit.yes.length or p.pros.length %}<a href="#fit">Overview</a>{% endif %}
    <a href="#pricing">Pricing</a>
    <a href="#product">Product</a>
    <a href="#diligence">Due diligence</a>
    {%- if p.score_breakdown and p.score_breakdown.length %}<a href="#score">Score</a>{% endif %}
    {%- if alts.length %}<a href="#alternatives">Alternatives</a>{% endif %}
    {%- if p.faq and p.faq.length %}<a href="#faq">FAQ</a>{% endif %}
  </div>
</nav>

<main id="main">
{%- if v4.fit.yes.length or v4.fit.no.length or p.pros.length %}
<section id="fit" class="rv4-band rv4-band--white">
  <div class="container">
    {%- if v4.fit.yes.length or v4.fit.no.length %}
    <h2 class="rv4-h2">Who {{ p.name }} is for</h2>
    <div class="rv4-2col">
      {%- if v4.fit.yes.length %}
      <div class="rv4-list"><h3>A good fit if you</h3>{% for t in v4.fit.yes %}<p>{{ t }}</p>{% endfor %}</div>
      {%- endif %}
      {%- if v4.fit.no.length %}
      <div class="rv4-list"><h3>Look elsewhere if you</h3>{% for x in v4.fit.no %}<p>{{ x.text }}.{% if x.alt %} Compare <a href="{{ x.alt.url }}">{{ x.alt.name }}</a>.{% endif %}</p>{% endfor %}</div>
      {%- endif %}
    </div>
    {%- endif %}
    {%- if p.pros.length or p.cons.length %}
    {%- if v4.fit.yes.length or v4.fit.no.length %}<hr class="rv4-rule">{% endif %}
    <h2 class="rv4-h2">Pros and cons</h2>
    <div class="rv4-2col">
      <div class="rv4-list"><h3>Pros</h3>{% for t in p.pros %}<p>{{ t }}</p>{% endfor %}</div>
      <div class="rv4-list"><h3>Cons</h3>{% for t in p.cons %}<p>{{ t }}</p>{% endfor %}</div>
    </div>
    {%- endif %}
  </div>
</section>
{%- endif %}

<section id="pricing" class="rv4-band" aria-labelledby="pricing-h">
  <div class="container rv4-split">
    <div class="rv4-split__head">
      <h2 id="pricing-h" class="rv4-h2">{{ p.name }} pricing</h2>
      {%- if p.pricing.summary %}<p class="rv4-p">{{ p.pricing.summary }}</p>{% endif %}
      {%- if p.pricing.verified %}<p class="rv4-small">Pricing verified {{ p.pricing.verified | displayDate }}</p>{% endif %}
    </div>
    <div class="rv4-split__body">
      {%- if v4.pricingOfficial.length %}
      <div class="rv4-card">
        <div class="rv4-card__label">From {{ p.name }}</div>
        <dl class="rv4-dl">{% for i in v4.pricingOfficial %}<div><dt>{{ i.label }}</dt><dd>{{ i.value }}</dd></div>{% endfor %}</dl>
      </div>
      {%- elif p.pricing.plans and p.pricing.plans.length %}
      <div class="rv4-card">
        <div class="rv4-card__label">From {{ p.name }}</div>
        <dl class="rv4-dl">{% for pl in p.pricing.plans %}<div><dt>{{ pl.tier }}</dt><dd>{{ pl.price }}</dd>{% if pl.note %}<dd class="rv4-sub">{{ pl.note }}</dd>{% endif %}</div>{% endfor %}</dl>
      </div>
      {%- endif %}
      {%- if v4.pricingEstimates.length %}
      <div class="rv4-card rv4-card--dashed">
        <div class="rv4-card__label">Third-party listings, not official</div>
        {%- for e in v4.pricingEstimates %}
        <div class="rv4-est"><b class="num">{{ e.value }}</b><span>{{ e.label }}{% if e.verified %}, checked {{ e.verified | displayDate }}{% endif %}</span></div>
        {%- endfor %}
      </div>
      {%- endif %}
    </div>
  </div>
</section>

<section id="product" class="rv4-band rv4-band--white" aria-labelledby="product-h">
  <div class="container">
    <h2 id="product-h" class="rv4-h2">What {{ p.name }} does</h2>
    {%- if p.what_is and p.what_is.length %}<p class="rv4-p rv4-measure">{{ p.what_is[0] }}</p>{% endif %}
    {%- if p.screenshots and p.screenshots.length %}
    {%- set s0 = p.screenshots[0] %}
    <figure class="rv4-shot rv4-shot--main">
      <button type="button" class="rv4-shot__btn" data-shot="0" aria-label="Open screenshot: {{ s0.caption }}"><img src="{{ s0.file }}" alt="{{ s0.alt }}" width="{{ s0.width }}" height="{{ s0.height }}" decoding="async"></button>
      <figcaption>{{ s0.long or s0.caption }}</figcaption>
    </figure>
    {%- if p.screenshots.length > 1 %}
    <div class="rv4-thumbs">
      {%- for s in p.screenshots %}{% if not loop.first %}
      <figure class="rv4-shot"><button type="button" class="rv4-shot__btn rv4-shot__btn--thumb" data-shot="{{ loop.index0 }}" aria-label="Open screenshot: {{ s.caption }}"><img src="{{ s.file }}" alt="{{ s.alt }}" width="{{ s.width }}" height="{{ s.height }}" loading="lazy" decoding="async"></button><figcaption>{{ s.caption }}</figcaption></figure>
      {%- endif %}{% endfor %}
    </div>
    {%- endif %}
    {%- set sm = p.screenshots_meta %}
    {%- if sm %}<p class="rv4-small">{% if sm.origin == "vendor" %}Screenshots provided by {{ p.name }}{% else %}Captured by BeVerified{% endif %}, {{ sm.provided | displayDate }}.{% if sm.product_version %} Version {{ sm.product_version }}{% if sm.sample_data %} with sample data{% endif %}.{% endif %}</p>{% endif %}
    <dialog class="rv4-lightbox" id="rv4-lightbox" aria-label="Screenshot viewer">
      <figure>
        <img alt="">
        <div class="rv4-lightbox__bar">
          <figcaption></figcaption>
          <button type="button" data-step="-1" aria-label="Previous screenshot">←</button>
          <button type="button" data-step="1" aria-label="Next screenshot">→</button>
          <button type="button" data-close class="rv4-lightbox__close">Close</button>
        </div>
      </figure>
    </dialog>
    <script type="application/json" id="rv4-shots">[{% for s in p.screenshots %}{"src":{{ s.file | dump | safe }},"alt":{{ s.alt | dump | safe }},"caption":{{ (s.long or s.caption) | dump | safe }}}{% if not loop.last %},{% endif %}{% endfor %}]</script>
    {%- endif %}
    {%- if p.features and p.features.length %}
    <ul class="rv4-features">{% for f in p.features %}<li>{{ f }}</li>{% endfor %}</ul>
    {%- endif %}
  </div>
</section>

<section id="diligence" class="rv4-band" aria-labelledby="dd-h">
  <div class="container">
    <h2 id="dd-h" class="rv4-h2">Before you sign</h2>
    <p class="rv4-p rv4-lede">What your compliance, security and engineering teams will ask about {{ p.name }}. ◆ marks facts we confirmed with a source other than {{ p.name }}.</p>
    <div class="rv4-2col rv4-2col--cards">
      {%- if v4.networks.length or v4.networkFacts.length %}
      <div class="rv4-card">
        <h3 class="rv4-h3">{{ v4.profile.networks_heading }}</h3>
        <div class="rv4-rows">
          {%- for n in v4.networks %}
          <div{% if n.off %} class="rv4-off"{% endif %}><b>{% if n.evidence == "independent" %}<span class="rv4-ind" title="{{ ev.independent.label }}">◆</span> {% endif %}{{ n.name }}</b><span>{{ n.line }}</span></div>
          {%- endfor %}
          {%- for f in v4.networkFacts %}
          <div><b>{% if f.independent %}<span class="rv4-ind" title="{{ ev.independent.label }}">◆</span> {% endif %}{{ f.label }}</b><span>{{ f.value }}</span></div>
          {%- endfor %}
        </div>
      </div>
      {%- endif %}
      {%- if v4.integration.length %}
      <div class="rv4-card">
        <h3 class="rv4-h3">Integration and deployment</h3>
        <div class="rv4-rows">
          {%- for f in v4.integration %}
          <div><b>{% if f.independent %}<span class="rv4-ind" title="{{ ev.independent.label }}">◆</span> {% endif %}{{ f.label }}</b><span>{{ f.value }}</span></div>
          {%- endfor %}
        </div>
      </div>
      {%- endif %}
    </div>
    <div class="rv4-card rv4-card--wide">
      <div>
        <h3 class="rv4-h3">Security and company</h3>
        <dl class="rv4-dl">
          {%- for c in v4.certs %}
          <div><dt>{{ c.name }}</dt><dd{% if c.ok %} class="rv4-ok"{% endif %}>{{ c.status }}</dd>{% if c.what %}<dd class="rv4-sub">{{ c.what }}</dd>{% endif %}</div>
          {%- endfor %}
          <div><dt>Incidents</dt><dd{% if v4.incident.ok %} class="rv4-ok"{% endif %}>{% if v4.incident.href %}<a href="/incidents/">{{ v4.incident.value }}</a>{% else %}{{ v4.incident.value }}{% endif %}</dd></div>
          {%- for f in v4.company %}
          <div><dt>{% if f.independent %}<span class="rv4-ind" title="{{ ev.independent.label }}">◆</span> {% endif %}{{ f.label }}</dt><dd>{{ f.value }}</dd></div>
          {%- endfor %}
        </dl>
      </div>
      {%- if p.what_is and p.what_is.length > 1 %}<div class="rv4-card__aside"><p class="rv4-p">{{ p.what_is[1] }}</p></div>{% endif %}
    </div>
    {%- if incidentList.length %}
    <ol class="rv4-card rv4-inc" id="incidents">
      {%- for x in incidentList %}
      <li><span class="num"><time datetime="{{ x.date | iso }}">{{ x.date | displayDate }}</time></span><div><b>{{ x.title }}</b>{% if x.counted == false %} <span class="rv4-sub">(not counted in score)</span>{% endif %}<p>{{ x.summary }} <a href="/incidents/#{{ x.id }}">Vendor response and sources</a></p></div></li>
      {%- endfor %}
    </ol>
    {%- endif %}
    {%- if v4.questions.length %}
    <div class="rv4-card rv4-card--ink">
      <h3 class="rv4-h3">Questions to ask {{ p.name }} before you sign</h3>
      <ol class="rv4-questions">{% for q in v4.questions %}<li>{{ q }}</li>{% endfor %}</ol>
    </div>
    {%- endif %}
  </div>
</section>

{%- if p.score_breakdown and p.score_breakdown.length %}
<section id="score" class="rv4-band rv4-band--white" aria-labelledby="score-h">
  <div class="container rv4-split">
    <div class="rv4-split__head">
      <h2 id="score-h" class="rv4-h2">How we scored {{ p.name }}</h2>
      <p class="rv4-p">{{ p.score_breakdown.length }} weighted criteria from <a href="{{ site.v3.methodologyHref }}">methodology {{ p.methodology or "v3.0" }}</a>.{% if not p.methodology %} Travel Rule providers stay on it until their own methodology is published.{% endif %}</p>
      {%- if p.user_ratings and p.user_ratings.length %}
      <p class="rv4-small">User ratings are not part of the score.{% for r in p.user_ratings %} {{ r.platform }}: {{ r.rating | score1 }} from {{ r.count }} review{% if r.count != 1 %}s{% endif %}{% if r.checked %}, {{ r.checked | displayDate }}{% endif %}.{% endfor %}</p>
      {%- endif %}
    </div>
    <div class="rv4-split__body">
      {%- for b in p.score_breakdown %}
      <details class="rv4-crit">
        <summary>
          <span class="rv4-crit__name">{{ b.criterion }} <span class="rv4-sub">{{ b.weight }}%</span></span>
          {%- if b.score != null %}
          <span class="rv4-crit__bar" aria-hidden="true"><i style="width:{{ b.score * 20 }}%"></i></span><b class="num" aria-label="{{ b.score | score1 }} out of 5">{{ b.score | score1 }}</b>
          {%- else %}<span class="rv4-sub">Not publicly disclosed, so not scored</span>{% endif %}
          <span class="rv4-crit__plus" aria-hidden="true">+</span>
        </summary>
        {%- if b.note %}<p>{{ b.note }}</p>{% endif %}
      </details>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endif %}

{%- if alts.length or sp %}
<section id="alternatives" class="rv4-band" aria-labelledby="alt-h">
  <div class="container">
    <h2 id="alt-h" class="rv4-h2">Alternatives to {{ p.name }}</h2>
    {%- if alts.length %}
    <div class="rv4-alts">
      {%- for x in alts %}
      <a class="rv4-card rv4-alt" href="/providers/{{ x.q.slug }}/">
        {%- if x.q.logo.wordmark %}<img src="{{ x.q.logo.wordmark }}" alt="{{ x.q.name }}" loading="lazy">{% else %}<b class="rv4-alt__name">{{ x.q.name }}</b>{% endif %}
        {%- if x.q.score != null %}<span class="num rv4-alt__score"><b>{{ x.q.score | score1 }}</b> / 5</span>{% endif %}
        <span class="rv4-alt__text">Choose {{ x.q.name }} if {{ x.text }}</span>
        <span class="rv4-alt__go">Read review →</span>
      </a>
      {%- endfor %}
    </div>
    {%- endif %}
    {%- if sp %}
    <aside class="rv4-card rv4-ad-wide" aria-label="Sponsored">
      <span class="rv4-ad__logo rv4-ad__logo--lg">{% if sp.provider.logo.wordmark %}<img src="{{ sp.provider.logo.wordmark }}" alt="">{% else %}{{ sp.provider.name }}{% endif %}</span>
      <div class="rv4-ad-wide__body">
        <p class="rv4-ad__label"><svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="8" cy="8" r="6.5"/><path d="M8 7v4.5M8 4.8v.2"/></svg>Sponsored</p>
        <p class="rv4-ad-wide__name">{{ sp.provider.name }}</p>
        <p class="num rv4-sub">{{ sp.provider.score | score1 }} / 5 · #{{ sp.rank }} in {{ sp.category }}</p>
        {%- if sp.provider.tagline %}<p class="rv4-p">{{ sp.provider.tagline }}</p>{% endif %}
      </div>
      <div class="rv4-ad-wide__cta">
        <a class="btn btn--primary" href="{{ sp.provider.link.url }}" data-ad target="_blank">Visit site <span aria-hidden="true">↗</span></a>
        <a href="/providers/{{ sp.provider.slug }}/">Read our review</a>
      </div>
      <p class="rv4-small rv4-ad-wide__note">Paid placement. It does not change scores or rankings. <a href="/methodology/#advertising">How sponsored placements work</a></p>
    </aside>
    {%- endif %}
  </div>
</section>
{%- endif %}

{%- if p.faq and p.faq.length %}
<section id="faq" class="rv4-band rv4-band--white" aria-labelledby="faq-h">
  <div class="container rv4-split">
    <div class="rv4-split__head"><h2 id="faq-h" class="rv4-h2">FAQ</h2></div>
    <div class="rv4-split__body rv4-faq">
      {%- for f in p.faq %}
      <details{% if loop.first %} open{% endif %}><summary><h3>{{ f.q }}</h3></summary><p>{{ f.a }}</p></details>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endif %}

{%- if reading.length %}
<section id="reading" class="rv4-band" aria-labelledby="rd-h">
  <div class="container">
    <h2 id="rd-h" class="rv4-h2">Related reading</h2>
    <div class="rv4-reading">
      {%- for a in reading %}
      {%- set d = a.data.published or a.data.updated %}
      <a class="rv4-card rv4-post" href="{{ a.url }}">
        {%- if a.data.cover %}<img src="{{ a.data.cover }}" alt="" width="1600" height="900" loading="lazy" decoding="async">{% endif %}
        <span class="rv4-post__body"><span class="rv4-sub">{{ a.data.section | sectionLabel }}{% if d %} · <time datetime="{{ d | iso }}">{{ d | displayDate }}</time>{% endif %}</span><b>{{ a.data.title }}</b></span>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endif %}

{%- if p.sources and p.sources.length %}
<section id="sources" class="rv4-band rv4-band--white rv4-band--tight" aria-labelledby="src-h">
  <div class="container rv4-split">
    <div class="rv4-split__head"><h2 id="src-h" class="rv4-h2 rv4-h2--sm">Sources</h2></div>
    <div class="rv4-split__body">
      <p class="rv4-p">{% if p.last_verified %}Checked {{ p.last_verified | displayDate }} against{% else %}Built from{% endif %} {{ v4.sources.total }} sources{% if v4.sources.summary %}: {{ v4.sources.summary }}{% endif %}.{% if v4.sources.opened %} All opened in {{ v4.sources.opened }}.{% endif %}</p>
      <details class="rv4-sources">
        <summary>Show all {{ v4.sources.total }} sources</summary>
        {%- for g in v4.sources.groups %}
        <h3>{{ g.title }} <span class="rv4-sub num">{{ g.items.length }}</span></h3>
        <ul>{% for s in g.items %}<li id="src-{{ s.n }}">{% if s.publisher %}{{ s.publisher }} · {% endif %}<a href="{{ s.url }}" rel="noopener">{{ s.title }}</a>{% if s.accessed and not v4.sources.opened %} <span class="rv4-sub">{{ s.accessed | displayDate }}</span>{% endif %}</li>{% endfor %}</ul>
        {%- endfor %}
      </details>
      {%- if author %}
      <div class="rv4-author">
        <img class="avatar" src="{{ author.photo }}" alt="{{ author.name }}">
        <p><b>{{ author.name }}</b>, {{ author.role }}. {{ author.bio }} {% if author.url %}<a href="{{ author.url }}">Profile</a>{% endif %}{% if author.linkedin %} · <a href="{{ author.linkedin }}" rel="noopener" target="_blank">LinkedIn ↗</a>{% endif %}</p>
      </div>
      {%- endif %}
    </div>
  </div>
</section>
{%- endif %}
</main>
</div>

{%- if p.screenshots and p.screenshots.length %}
<script>
(function () {
  var box = document.getElementById("rv4-lightbox"), data = document.getElementById("rv4-shots");
  if (!box || !data || typeof box.showModal !== "function") return;
  var shots = JSON.parse(data.textContent), i = 0, img = box.querySelector("img"), cap = box.querySelector("figcaption");
  function show(n) { i = (n + shots.length) % shots.length; img.src = shots[i].src; img.alt = shots[i].alt; cap.textContent = shots[i].caption + " · " + (i + 1) + " of " + shots.length; }
  document.querySelectorAll("[data-shot]").forEach(function (b) {
    b.addEventListener("click", function () { show(Number(b.getAttribute("data-shot"))); box.showModal(); });
  });
  box.addEventListener("click", function (e) {
    var t = e.target;
    if (t === box || t.hasAttribute("data-close")) box.close();
    else if (t.hasAttribute("data-step")) show(i + Number(t.getAttribute("data-step")));
  });
  box.addEventListener("keydown", function (e) {
    if (e.key === "ArrowRight") show(i + 1);
    if (e.key === "ArrowLeft") show(i - 1);
  });
})();
</script>
{%- endif %}
