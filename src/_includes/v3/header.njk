{#- Header with mega menu. Structure: site.json → v3.menu; resolved data: src/_data/megaMenu.js.
    Without JS a panel opens on hover or keyboard focus (CSS); with JS (.mm-js) buttons toggle it. -#}
{%- set mm = megaMenu %}
{%- set chev %}<svg class="mm-chev" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5 6 7.5l3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endset %}
<header class="site-header" data-mm>
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label="BeVerified home">{% include "v3/logo.njk" %}</a>
    <nav class="site-nav" id="site-nav" aria-label="Primary">

      <div class="mm-item" data-mm-item>
        <button type="button" class="mm-top{% if navCurrent == 'use-cases' or navCurrent == 'regions' %} is-current{% endif %}" aria-expanded="false" aria-controls="mm-rankings">{{ mm.rankings.label }}{{ chev | safe }}</button>
        <div class="mm-panel" id="mm-rankings">
          <div class="mm-wrap mm-rank">
            {%- for col in [1, 2, 3] %}
            <div class="mm-col">
              {%- for g in mm.rankings.groups %}{% if g.col == col %}
              <div class="mm-group">
                <p class="mm-h">{{ g.title }}</p>
                {%- for it in g.items %}
                <a class="mm-row{% if it.on %} is-on{% endif %}" href="{{ it.href }}" data-mm-cat="{{ it.id }}">{{ it.label }}</a>
                {%- endfor %}
              </div>
              {%- endif %}{% endfor %}
              {%- if col == 1 and mm.rankings.links[0] %}<a class="mm-more mm-col__more" href="{{ mm.rankings.links[0][1] }}">{{ mm.rankings.links[0][0] }} <span aria-hidden="true">→</span></a>{% endif %}
              {%- if col == 3 %}
              <div class="mm-group">
                <p class="mm-h">By country</p>
                <div class="mm-countries">{% for r in mm.rankings.regions %}<a href="{{ r.href }}">{{ r.label }}</a>{% endfor %}</div>
              </div>
              {%- if mm.rankings.links[1] %}<a class="mm-more mm-col__more" href="{{ mm.rankings.links[1][1] }}">{{ mm.rankings.links[1][0] }} <span aria-hidden="true">→</span></a>{% endif %}
              {%- endif %}
            </div>
            {%- endfor %}
            {#- Preview = ID card: real rank, award and the score this ranking sorts on; sponsored row from placements.yml surface: ranking. -#}
            <div class="mm-preview">
              {%- for g in mm.rankings.groups %}{% for it in g.items %}
              <div class="mm-pv{% if it.on %} is-on{% endif %}" data-mm-pv="{{ it.id }}">
                <p class="mm-pv__head"><b>{{ it.label }}</b><span>{{ it.scoreLabel }}</span></p>
                {%- for p in it.top %}
                <a class="mm-pv__row" href="{{ p.href or it.href }}">
                  <span class="mm-pv__rk">#{{ p.rank }}</span>
                  <span class="mm-wm">{% if p.wordmark %}<img src="{{ p.wordmark }}" alt="{{ p.name }}" loading="lazy" decoding="async">{% else %}<b>{{ p.name }}</b>{% endif %}</span>
                  <span class="mm-pv__aw">{{ p.award }}</span>
                  <span class="mm-pv__sc">{% if p.score != null %}{{ p.score | score1 }}{% endif %}</span>
                </a>
                {%- endfor %}
                {%- if it.sponsor %}{% set sp = it.sponsor %}
                <div class="mm-pv__row mm-pv__row--sp">
                  <span class="mm-pv__rk">#{{ sp.rank }}</span>
                  <a class="mm-wm" href="{{ sp.href }}">{% if sp.wordmark %}<img src="{{ sp.wordmark }}" alt="{{ sp.name }}" loading="lazy" decoding="async">{% else %}<b>{{ sp.name }}</b>{% endif %}</a>
                  <span class="mm-pv__aw">Sponsored{% if sp.score != null %} · {{ it.scoreLabel }} {{ sp.score | score1 }}{% endif %}</span>
                  <a class="mm-pv__go" href="{{ sp.url }}" data-ad target="_blank">Visit site <span aria-hidden="true">↗</span></a>
                </div>
                {%- endif %}
                <p class="mm-pv__mrz" aria-hidden="true">{{ it.mrz | mrzLine }}</p>
                <a class="mm-pv__all" href="{{ it.href }}">See the full {{ it.label }} ranking <span aria-hidden="true">→</span></a>
              </div>
              {%- endfor %}{% endfor %}
            </div>
          </div>
        </div>
      </div>

      <div class="mm-item" data-mm-item>
        <button type="button" class="mm-top{% if navCurrent == 'reviews' %} is-current{% endif %}" aria-expanded="false" aria-controls="mm-reviews">{{ mm.reviews.label }}{{ chev | safe }}</button>
        <div class="mm-panel" id="mm-reviews">
          <div class="mm-wrap mm-rev">
            <div>
              <p class="mm-h mm-h--row"><span>Most read reviews</span>{% if mm.reviews.links[0] %}<a class="mm-more" href="{{ mm.reviews.links[0][1] }}">{{ mm.reviews.links[0][0] }} <span aria-hidden="true">→</span></a>{% endif %}</p>
              <div class="mm-cards">
                {%- for p in mm.reviews.mostRead %}
                <a class="mm-card" href="{{ p.href }}">
                  <span class="mm-wm">{% if p.wordmark %}<img src="{{ p.wordmark }}" alt="" loading="lazy" decoding="async">{% else %}<b>{{ p.name }}</b>{% endif %}</span>
                  <span class="mm-card__txt"><b>{{ p.name }} review</b><span>{{ p.tagline }}</span></span>
                  <span class="mm-card__sc">{% if p.score != null %}{{ p.score | score1 }}{% endif %}</span>
                </a>
                {%- endfor %}
              </div>
              {%- if mm.reviews.sponsor %}{% set sp = mm.reviews.sponsor %}
              <div class="mm-sp">
                <span class="mm-wm">{% if sp.wordmark %}<img src="{{ sp.wordmark }}" alt="" loading="lazy" decoding="async">{% else %}<b>{{ sp.name }}</b>{% endif %}</span>
                <span class="mm-card__txt"><span class="mm-sp__label">Sponsored{% if sp.score != null %} · score {{ sp.score | score1 }}{% endif %} · #{{ sp.rank }} in {{ sp.ranking }}</span><span>{{ sp.tagline }}</span></span>
                <span class="mm-sp__cta"><a href="{{ sp.href }}">Read {{ sp.name }} review</a><a class="mm-pv__go" href="{{ sp.url }}" data-ad target="_blank">Visit site <span aria-hidden="true">↗</span></a></span>
              </div>
              {%- endif %}
            </div>
            {%- if mm.reviews.alternatives.length %}
            <div class="mm-list">
              <p class="mm-h">Alternatives</p>
              {%- for p in mm.reviews.alternatives %}<a href="{{ p.href }}#alternatives">{{ p.name }} alternatives</a>{% endfor %}
            </div>
            {%- endif %}
            {%- for a in collections.articles | articleAt(mm.reviews.compare) %}
            <div>
              <p class="mm-h mm-h--row"><span>Head to head</span><a class="mm-more" href="/category/compare/">All <span aria-hidden="true">→</span></a></p>
              <a class="mm-post mm-post--row" href="{{ a.url }}">{% if a.data.cover %}<img src="{{ a.data.cover }}" alt="" loading="lazy" decoding="async" width="1600" height="900">{% endif %}<b>{{ a.data.cover_label or a.data.title }}</b></a>
            </div>
            {%- endfor %}
          </div>
        </div>
      </div>

      <div class="mm-item" data-mm-item>
        <button type="button" class="mm-top{% if navCurrent == 'blog' %} is-current{% endif %}" aria-expanded="false" aria-controls="mm-blog">{{ mm.blog.label }}{{ chev | safe }}</button>
        <div class="mm-panel" id="mm-blog">
          <div class="mm-wrap mm-blog">
            {%- for a in collections.articles | articleAt(mm.blog.feature.url) %}
            <a class="mm-post mm-post--feature" href="{{ a.url }}">{% if a.data.cover %}<img src="{{ a.data.cover }}" alt="" loading="lazy" decoding="async" width="1600" height="900">{% endif %}<span class="mm-meta">{{ a.data.section | sectionLabel }}</span><b>{{ mm.blog.feature.label }}</b></a>
            {%- endfor %}
            <div>
              <p class="mm-h mm-h--row"><span>Latest</span>{% if mm.blog.links[0] %}<a class="mm-more" href="{{ mm.blog.links[0][1] }}">{{ mm.blog.links[0][0] }} <span aria-hidden="true">→</span></a>{% endif %}</p>
              <div class="mm-latest">
                {%- for a in collections.articles | menuLatest(mm.blog.feature.url, mm.blog.latest) %}
                <a class="mm-post mm-post--row" href="{{ a.url }}">{% if a.data.cover %}<img src="{{ a.data.cover }}" alt="" loading="lazy" decoding="async" width="1600" height="900">{% endif %}<span><span class="mm-meta">{{ a.data.section | sectionLabel }}{% if a.data.published %} · {{ a.data.published | displayDate }}{% endif %}</span><b>{{ a.data.title }}</b></span></a>
                {%- endfor %}
                {#- Partner content (placements.yml surface: menu-blog): a paid article we edited, labelled on the article too. -#}
                {%- if mm.blog.sponsor %}{% for a in collections.articles | articleAt(mm.blog.sponsor.url) %}
                <a class="mm-post mm-post--row mm-post--sp" href="{{ a.url }}">{% if a.data.cover %}<img src="{{ a.data.cover }}" alt="" loading="lazy" decoding="async" width="1600" height="900">{% endif %}<span><span class="mm-meta">Sponsored · Partner content by {{ a.data.sponsored_by }}</span><b>{{ a.data.title }}</b></span></a>
                {%- endfor %}{% endif %}
              </div>
            </div>
            <div class="mm-list">
              <p class="mm-h">Sections</p>
              {%- for l in mm.blog.sections %}<a href="{{ l[1] }}">{{ l[0] }}</a>{% endfor %}
              <p class="mm-h mm-h--gap">Reference</p>
              {%- for l in mm.blog.reference %}<a href="{{ l[1] }}">{{ l[0] }}</a>{% endfor %}
            </div>
          </div>
        </div>
      </div>
{%- for item in site.v3.nav %}
      <a class="mm-link" href="{{ item.href }}"{% if item.key and item.key == navCurrent %} aria-current="page"{% endif %}>{{ item.label }}</a>
{%- endfor %}
      <a href="{{ site.v3.navAside.href }}" class="mm-link site-nav__mobile-only btn-prov">{{ site.v3.navAside.label }}</a>
    </nav>
    <a class="site-header__aside btn-prov" href="{{ site.v3.navAside.href }}">{{ site.v3.navAside.label }}</a>
    <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
  </div>
</header>
