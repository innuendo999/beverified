{#- Capability matrix table: legend + scrolling table. Needs `matrix` (buildMatrix in src/_lib/capabilities.js)
    and `matrixCaption`. Used by category pages and by the Alternatives section of reviews. -#}
<p class="cap-legend">Checked against each provider's own pages{% if matrix.checked %}, {{ matrix.checked | displayDate }}{% endif %}. Sources for each cell are on the provider's review.{% if matrix.certNote %} {{ matrix.certNote }}{% endif %}</p>
<p class="cap-legend cap-legend--key">{% for l in matrix.legend %}<span><i class="cap-dot cap-dot--{{ l[0] }}" aria-hidden="true"></i>{{ l[1] }}</span>{% if not loop.last %} {% endif %}{% endfor %}</p>
<div class="card cap-matrix">
  <div class="cap-matrix__scroll" role="region" aria-label="Capability matrix, scrolls sideways" tabindex="0">
    <table class="cap-table">
      <caption class="visually-hidden">{{ matrixCaption }}</caption>
      <thead><tr><th scope="col">Provider</th>{% for col in matrix.cols %}<th scope="col">{% if col.term %}<a href="{{ col.term }}" title="What is {{ col.label }}?">{{ col.label }}</a>{% else %}{{ col.label }}{% endif %}</th>{% endfor %}</tr></thead>
      <tbody>
      {%- for row in matrix.rows %}
        <tr>
          <th scope="row"><a href="/providers/{{ row.slug }}/">{{ row.name }}</a></th>
          {%- for cell in row.cells %}
          <td>{% if cell.sym %}<i class="cap-dot cap-dot--{{ cell.sym }}" aria-hidden="true"></i>{% endif %}{{ cell.label }}{% if cell.note %}<small>{{ cell.note }}</small>{% endif %}</td>
          {%- endfor %}
        </tr>
      {%- endfor %}
      </tbody>
    </table>
  </div>
</div>
