---
layout: v3.njk
---
{#- KYC Certification Tracker (owner approved the design canvas "BeVerified: KYC Certification Tracker, page design", 2026-11-20;
    redesigned in the AML Fines Tracker style, canvas page "Certification Tracker", approved 2026-11-27).
    Rows are <details>, so every entry opens without JS; search and filters need JS and stay hidden without it.
    No source link per certificate (owner): sources ship in the CSV/JSON download. Rows A to Z, never ranked. -#}
<main id="main" class="af ct" data-ct>
  <div class="af-top">
    <svg class="af-top__guilloche" viewBox="0 0 1280 460" preserveAspectRatio="none" aria-hidden="true" focusable="false">{% for g in ct.guilloche %}<path d="{{ g.d }}"{% if g.strong %} class="is-strong"{% endif %}/>{% endfor %}</svg>
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li class="sep" aria-hidden="true">›</li><li aria-current="page">KYC Certification Tracker</li></ol></nav>
      <header class="af-hero">
        <div class="af-hero__text">
          <h1 class="af-hero__title">KYC Certification Tracker</h1>
          <p class="af-hero__sub">Independent test results and certifications for {{ list.length }} KYC and identity verification providers we review. A green check means we found the provider on the issuer’s register or letter. Everything else is the vendor’s own claim.</p>
          <p class="af-hero__cta"><a class="btn btn--primary" href="#matrix">Compare the {{ list.length }} providers</a><a class="btn btn--secondary" href="#reuse">Download the data</a></p>
          <p class="af-hero__meta num">Checked <time datetime="{{ certTracker.checked | iso }}">{{ certTracker.checked | displayDate }}</time> against
            {%- for s in sourcesMain %}{% if not loop.first %}{% if loop.last %} and{% else %},{% endif %}{% endif %} <a href="{{ s.url }}" rel="noopener">{{ s.name }}</a>{% if loop.last %}.{% endif %}{% endfor %}
            {%- for s in sourcesOther %} <a href="{{ s.url }}" rel="noopener">{{ s.name }}</a> checked <time datetime="{{ s.checked | iso }}">{{ s.checked | displayDate }}</time>.{% endfor %}</p>
        </div>
        <aside class="af-card" aria-labelledby="ct-card-h">
          <div class="af-card__body">
            <h2 id="ct-card-h" class="af-card__title">Confirmed with the issuer</h2>
            <p class="af-card__big num">{{ ct.okProviders }}<span class="ct-card__of"> of {{ list.length }}</span></p>
            <p class="af-card__note">providers hold at least one result we could confirm.</p>
            <dl class="af-card__rows num">
              <div><dt>Results we confirmed</dt><dd>{{ ct.nConfirmed }}</dd></div>
              <div><dt>Stated by the vendor only</dt><dd>{{ ct.nStated }}</dd></div>
              <div><dt>Providers with no confirmed result</dt><dd>{{ ct.noOk }}</dd></div>
            </dl>
          </div>
          <div class="af-mrz" aria-hidden="true"><div>{{ ["CERT", "KYC", "", ct.okProviders, "OF", list.length, "CONFIRMED"] | join("<") | mrzLine }}</div><div>{{ ["CHECKED", certTracker.checked | iso | replace("-", ""), "", "BEVERIFIED", "ORG"] | join("<") | mrzLine }}</div></div>
        </aside>
      </header>
    </div>
  </div>
  <div class="container">
  <div class="af-micro" aria-hidden="true"></div>

  <div class="ct-tools" data-ct-tools hidden>
    <label for="ct-q" class="visually-hidden">Find a provider</label>
    <input id="ct-q" class="af-search ct-q" type="search" autocomplete="off" spellcheck="false" placeholder="Find a provider">
    <label class="ct-must">Must hold
      <select data-ct-must>
        <option value="any">Any certification</option>
        {%- for c in columns %}<option value="{{ c.key }}">{{ c.label }}</option>{% endfor %}
      </select>
    </label>
    <div class="af-seg" role="group" aria-label="Show">
      <button type="button" aria-pressed="true" data-ct-seg="all">All providers</button><button type="button" aria-pressed="false" data-ct-seg="ok">With a confirmed result</button>
    </div>
  </div>
  <div class="ct-legend">
    <span class="ct-cell--ok">{% icon "check", "", 16 %}Confirmed on the issuer’s register or letter</span>
    <span><span class="ct-chip">Vendor says</span>stated by the vendor only</span>
    <span><span class="ct-dot" aria-hidden="true">·</span>none found</span>
    <span class="ct-shown num" aria-live="polite" data-ct-shown>All {{ list.length }} providers</span>
  </div>

  <section id="matrix" aria-labelledby="ct-h">
    <h2 id="ct-h" class="visually-hidden">Providers and their checks</h2>
    <div class="ct-scroll">
      <div class="ct-table">
        <div class="ct-cols" aria-hidden="true"><span>Provider</span>{% for c in ct.cols %}<span>{{ c.label }}<em class="num">{{ c.ok }} confirmed</em></span>{% endfor %}</div>
        <ol class="ct-list">
          {%- for r in list %}
          <li id="{{ r.slug }}" class="ct-row" data-ct-name="{{ r.name | lower }}" data-ct-ok="{{ ct.okAny[r.slug] }}" data-ct-has="{{ ct.has[r.slug] }}">
            <details>
              <summary>
                <span class="ct-name">{% icon "chevron-down", "", 16 %}<b>{{ r.name }}</b></span>
                {%- for c in r.cells %}
                <span class="ct-cell ct-cell--{{ c.kind }}"><span class="visually-hidden">{{ columns[loop.index0].label }}: </span>{% if c.kind == 'ok' %}{% icon "check", "", 16 %}{{ c.text }}{% elif c.kind == 'stated' %}<span class="ct-chip">Vendor says</span>{% elif c.kind == 'progress' %}<span class="ct-chip">In progress</span>{% else %}<span class="ct-dot" aria-hidden="true">·</span><span class="visually-hidden">{{ c.text }}</span>{% endif %}</span>
                {%- endfor %}
              </summary>
              <div class="ct-entry">
                <ul class="ct-cards">
                  {%- for e in r.entries %}
                  <li><b>{{ e.name }}</b>{% if e.what %}<span>{{ e.what }}</span>{% endif %}<em class="ct-st ct-st--{{ e.status }}">{{ e.statusLabel }}</em></li>
                  {%- endfor %}
                </ul>
                <p class="ct-links"><a href="/providers/{{ r.slug }}/">{{ r.name }} review</a></p>
              </div>
            </details>
          </li>
          {%- endfor %}
        </ol>
        <p class="ct-empty" data-ct-empty hidden><span data-ct-empty-text></span> Clear the search or pick another certification. The tracker lists only providers we review. <a href="/providers/">See all reviews</a></p>
      </div>
    </div>
    <p class="ct-note">Sorted A to Z. The tracker does not rank providers and has no effect on their scores. A dot means we found no public claim.</p>
  </section>

  <div class="ct-notes">
    <section aria-labelledby="ct-what">
      <h2 id="ct-what">What each test proves, and what it does not</h2>
      <dl class="ct-dl">
        <div><dt>iBeta ISO/IEC 30107-3</dt><dd>A lab letter that one product version resisted presentation attacks such as printed photos and masks, at Level 1, 2 or 3. It covers that product and version only, and it does not test injected camera feeds.</dd></div>
        <div><dt>UK DVS register</dt><dd>The UK government’s list of identity services certified against its digital verification services trust framework. The entry names one service and has an expiry date.</dd></div>
        <div><dt>FIDO IDV</dt><dd>FIDO Alliance certification of a face verification product or a document authenticity product, tested by an accredited lab.</dd></div>
        <div><dt>DHS RIVR</dt><dd>Results of the US DHS remote identity validation rally, published under aliases. We list a result only when the vendor has said which alias is theirs.</dd></div>
        <div><dt>ACCS</dt><dd>The Age Check Certification Scheme registry, which covers identity proofing (ISO/IEC TS 29003) and age checks.</dd></div>
        <div><dt>ISO/IEC 27001 and SOC 2</dt><dd>There is no public register. We mark these confirmed only when we could open the certificate or report issued by the certification body or auditor.</dd></div>
      </dl>
    </section>
    <aside aria-labelledby="ct-changes">
      <h2 id="ct-changes">Recent changes</h2>
      <ol class="ct-changes">
        {%- for c in changeList %}
        <li><time class="num" datetime="{{ c.date | iso }}">{{ c.date | displayDate }}</time><span><a href="#{{ c.slug }}" data-ct-open="{{ c.slug }}">{{ c.name }}</a>: {{ c.text }}</span></li>
        {%- endfor %}
      </ol>
    </aside>
  </div>

  <div class="ct-bottom">
    <section id="reuse" class="ct-card" aria-labelledby="reuse-h">
      <h2 id="reuse-h">Cite or reuse this data</h2>
      <p>The data is free to reuse under <a href="https://creativecommons.org/licenses/by/4.0/" rel="license noopener">CC BY 4.0</a> with a link back to this page. The download includes the source of every entry.</p>
      <p class="ct-cite">BeVerified, “KYC Certification Tracker”, sources checked {{ certTracker.checked | displayDate }}, {{ site.url }}/kyc-certification-tracker/</p>
      <p class="ct-btns"><a class="btn btn--primary" href="/kyc-certification-tracker/certifications.csv" download>Download CSV</a><a class="btn btn--secondary" href="/kyc-certification-tracker/certifications.json" download>Download JSON</a></p>
    </section>
    <section class="ct-card" aria-labelledby="fix-h">
      <h2 id="fix-h">Something wrong in your entry?</h2>
      <p>Write to <a href="mailto:support@beverified.org?subject=KYC%20Certification%20Tracker%3A%20correction">support@beverified.org</a> with a link to the register entry or letter that names your company. Entries are free, and payment never changes them.</p>
    </section>
  </div>
  </div>
</main>

<script>
(() => {
  const root = document.querySelector("[data-ct]");
  const rows = [...root.querySelectorAll(".ct-row")];
  const segs = [...root.querySelectorAll("[data-ct-seg]")];
  const must = root.querySelector("[data-ct-must]");
  const input = document.getElementById("ct-q");
  const shown = root.querySelector("[data-ct-shown]");
  const empty = root.querySelector("[data-ct-empty]");
  const emptyText = root.querySelector("[data-ct-empty-text]");
  const norm = (s) => s.toLowerCase().replace(/[^a-z0-9]/g, "");
  let seg = "all";
  const apply = () => {
    const nq = norm(input.value.trim());
    const m = must.value;
    let n = 0;
    rows.forEach((r) => {
      const ok = r.dataset.ctOk ? r.dataset.ctOk.split(" ") : [];
      const has = r.dataset.ctHas ? r.dataset.ctHas.split(" ") : [];
      const byF = seg === "ok" ? (m === "any" ? ok.length > 0 : ok.includes(m)) : (m === "any" || has.includes(m));
      const byQ = !nq || norm(r.dataset.ctName).includes(nq);
      r.hidden = !(byF && byQ);
      if (!r.hidden) n++;
    });
    segs.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.ctSeg === seg)));
    shown.textContent = n === rows.length ? `All ${rows.length} providers` : `${n} of ${rows.length} providers shown`;
    empty.hidden = n > 0;
    if (!n) emptyText.textContent = "No provider matches.";
  };
  segs.forEach((b) => b.addEventListener("click", () => { seg = b.dataset.ctSeg; apply(); }));
  must.addEventListener("change", apply);
  input.addEventListener("input", apply);
  const open = (id) => {
    const li = document.getElementById(id);
    if (!li || !li.classList.contains("ct-row")) return;
    if (li.hidden) { seg = "all"; must.value = "any"; input.value = ""; apply(); }
    li.querySelector("details").open = true;
    li.scrollIntoView({ block: "start" });
  };
  if (location.hash) open(location.hash.slice(1));
  window.addEventListener("hashchange", () => open(location.hash.slice(1)));
  root.querySelector("[data-ct-tools]").hidden = false;
})();
</script>
