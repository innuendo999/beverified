---
layout: v3.njk
---
{#- Homepage. Design: design/Homepage V3 - BeVerified (Desktop).dc.html. Content: src/_data/home.yml -#}
<main id="main">
<section class="hero" aria-labelledby="hero-h1">
  <slab-field class="hero__field" theme="light" mode="loop" filter="0" win="0.04,0.66,0.52,0.97" cx="0.38" cy="0.8" scale="1.2" mask="radial-gradient(ellipse 60% 48% at 30% 100%, #000 45%, transparent 100%)"></slab-field>
  <div class="hero__inner">
    <div>
      <h1 id="hero-h1" class="hero__h1">{{ home.h1 }} <span>{{ home.h1_muted }}</span></h1>
      <p class="hero__lede">{{ home.lede }}</p>
      <div class="cta-row">
        <a class="btn btn--primary" href="#top-rated">See top providers</a>
        <a class="btn btn--secondary" href="#use-case">Browse by use case</a>
      </div>
    </div>
    <div class="card picks" role="region" aria-labelledby="qp-h">
      <div class="picks__head"><h2 id="qp-h">Quick picks</h2><span>From our editorial scores</span></div>
      <ol>
        {%- for q in picks %}
        <li class="picks__item">
          <span class="pill{% if loop.first %} pill--dark{% endif %}">{% if loop.first %}◆ {% endif %}{{ q.label }}</span>
          <div class="picks__row">
            <div class="minw-0">
              <div class="picks__logo">{% if q.p.logo.wordmark %}<img src="{{ q.p.logo.wordmark }}" alt="{{ q.p.name }}">{% else %}<b>{{ q.p.name }}</b>{% endif %}</div>
              <p class="picks__reason">{{ q.reason or q.p.tagline }}</p>
              <a class="fs-14 fw-500" href="/providers/{{ q.p.slug }}/">Read review →</a>
            </div>
            <div class="picks__score" role="img" aria-label="{{ q.p.score | score1 }} out of 5">
              <div aria-hidden="true"><b>{{ q.p.score | score1 }}</b><small>/ 5</small></div>
              <div class="meter meter--sm" aria-hidden="true">{% for w in (q.p.score | meter) %}<span><i class="w-{{ w }}"></i></span>{% endfor %}</div>
            </div>
          </div>
        </li>
        {%- endfor %}
      </ol>
    </div>
  </div>
</section>

<section class="container home-section home-section--strip" aria-labelledby="logos-cap">
  <p id="logos-cap" class="strip__cap">Independently reviewed providers</p>
  <ul class="strip">{% for p in strip %}<li><a href="/providers/{{ p.slug }}/" aria-label="{{ p.name }} review"><img loading="lazy" src="{{ p.logo.wordmark }}" alt="{{ p.name }}"></a></li>{% endfor %}</ul>
</section>

<section id="use-case" class="container home-section" aria-labelledby="uc-h">
  <div class="section-head"><h2 id="uc-h" class="h-split h-split--xl">Pick by use case.<span>One ranking for each job</span></h2><a class="btn btn--secondary btn--sm" href="/use-cases/">All use cases</a></div>
  {#- Layout A (owner, 2026-11-10). Data: index.11tydata.js → useCaseGroups (top 3 from rankings.yml, sponsor from placements.yml).
      Without JS every panel is shown in a plain list. With JS (.is-live): desktop = buttons on the left, one panel on the right;
      under 860px = accordion (button, then its panel). Each button controls the panel with the same id. -#}
  {%- set ucRows = useCaseGroups.length %}{% for g in useCaseGroups %}{% set ucRows = ucRows + g.items.length %}{% endfor %}
  <div class="ucx" data-ucx style="--ucx-rows:{{ ucRows }}">
    {%- for g in useCaseGroups %}
    <p class="ucx__group">{{ g.name }}</p>
    {%- for u in g.items %}
    <button type="button" class="ucx__tab" id="uc-t-{{ u.id }}" aria-controls="uc-p-{{ u.id }}" aria-expanded="false" data-ucx-tab="{{ u.id }}"><span>{{ u.name }}</span><svg class="ucx__chev" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 6l4 4 4-4"/></svg><span class="ucx__arrow" aria-hidden="true">→</span></button>
    <section class="card ucx__panel" id="uc-p-{{ u.id }}" aria-labelledby="uc-h-{{ u.id }}" data-ucx-panel="{{ u.id }}">
      <div class="ucx__head">
        <div>
          <h3 id="uc-h-{{ u.id }}" class="ucx__title">{{ u.name }}</h3>
          <p>{{ u.def }}</p>
        </div>
        <a class="ucx__more" href="{{ u.url }}">See the full ranking<span class="visually-hidden"> for {{ u.name }}</span> →</a>
      </div>
      <ol class="ucx__list">
        {%- for t in u.top %}
        <li>
          {%- if t.url %}<a class="ucx__row" href="{{ t.url }}">{% else %}<div class="ucx__row">{% endif %}
            <span class="ucx__rank" aria-hidden="true">{{ t.rank }}</span>
            <span class="ucx__tile{% if not t.logo %} ucx__tile--wm{% elif t.fit == 'contain' %} ucx__tile--contain{% endif %}"{% if t.logo and t.bg != '#FFFFFF' %} style="background:{{ t.bg }}"{% endif %}>{% if t.logo %}<img src="{{ t.logo }}" alt="" loading="lazy" decoding="async">{% elif t.wordmark %}<img src="{{ t.wordmark }}" alt="" loading="lazy" decoding="async">{% else %}<span>{{ t.name }}</span>{% endif %}</span>
            <span class="ucx__who">
              <span class="ucx__name"><span class="visually-hidden">#{{ t.rank }} </span>{{ t.name }}</span>
              {%- if t.award == "Editor's Choice" %}
              <span class="ucx__award ucx__award--ec"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="8" cy="8" r="6.5"/><path d="M5.2 8.2l1.9 1.9 3.7-4"/></svg>{{ t.award }}</span>
              {%- elif t.award %}
              <span class="ucx__award">{{ t.award }}</span>
              {%- endif %}
            </span>
            {%- if t.score != null %}
            <span class="ucx__score"><b>{{ t.score | score1 }}</b><small> / 5</small>
              <span class="meter meter--sm" aria-hidden="true">{% for w in (t.score | meter) %}<span><i class="w-{{ w }}"></i></span>{% endfor %}</span>
            </span>
            {%- endif %}
          {% if t.url %}</a>{% else %}</div>{% endif %}
        </li>
        {%- endfor %}
      </ol>
      {%- if u.sponsor %}
      {%- set sp = u.sponsor %}
      <div class="ucx__sp">
        <p class="ucx__sp-note"><span class="sp-tag"><svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 6.5v3h2.5L9 12.5v-9L4.5 6.5z"/><path d="M11.5 6a3 3 0 0 1 0 4"/></svg>Sponsored</span>Paid placement. It does not change the ranking above.</p>
        <a class="ucx__sp-row" href="{{ sp.url }}">
          <span class="ucx__tile ucx__tile--sm{% if not sp.logo %} ucx__tile--wm{% elif sp.fit == 'contain' %} ucx__tile--contain{% endif %}"{% if sp.logo and sp.bg != '#FFFFFF' %} style="background:{{ sp.bg }}"{% endif %}>{% if sp.logo %}<img src="{{ sp.logo }}" alt="" loading="lazy" decoding="async">{% elif sp.wordmark %}<img src="{{ sp.wordmark }}" alt="" loading="lazy" decoding="async">{% else %}<span>{{ sp.name }}</span>{% endif %}</span>
          <span class="ucx__who"><span class="ucx__name">{{ sp.name }}</span>{% if sp.line %}<span class="ucx__line">{{ sp.line }}</span>{% endif %}</span>
          <span class="ucx__sp-meta">#{{ sp.rank }} in our {{ u.name }} ranking · {{ sp.score | score1 }} / 5<span class="ucx__sp-go">Read review →</span></span>
        </a>
      </div>
      {%- endif %}
    </section>
    {%- endfor %}
    {%- endfor %}
  </div>
  <p class="ucx__foot">Rank and score come from our <a href="/methodology/">methodology</a>. Payment never changes scores or ranking order. <a href="/placement-options/">For providers</a></p>
  <script>
  (function () {
    var box = document.querySelector('[data-ucx]');
    if (!box) return;
    var tabs = [].slice.call(box.querySelectorAll('[data-ucx-tab]')), panels = [].slice.call(box.querySelectorAll('[data-ucx-panel]'));
    var narrow = window.matchMedia('(max-width: 860px)'), open = tabs.length ? tabs[0].getAttribute('data-ucx-tab') : null;
    function show(id) {
      open = id;
      tabs.forEach(function (t) { t.setAttribute('aria-expanded', String(t.getAttribute('data-ucx-tab') === id)); });
      panels.forEach(function (p) { p.hidden = p.getAttribute('data-ucx-panel') !== id; });
    }
    tabs.forEach(function (t) {
      t.addEventListener('click', function () {
        var id = t.getAttribute('data-ucx-tab');
        show(narrow.matches && id === open ? null : id);
      });
    });
    narrow.addEventListener('change', function () { if (!narrow.matches && !open) show(tabs[0].getAttribute('data-ucx-tab')); });
    box.classList.add('is-live');
    show(open);
  })();
  </script>
</section>

<section id="region" class="container home-section" aria-labelledby="rg-h">
  <div class="section-head"><h2 id="rg-h" class="h-split h-split--xl">Pick by region.<span>Local regulators, local documents</span></h2><a class="btn btn--secondary btn--sm" href="/providers/">All providers</a></div>
  {#- Pixel map: land grid from src/_data/regionGrid.json (scripts/region-map.mjs), pins and cards from index.11tydata.js → regionMap.
      Without JS the pins and cards are plain links; the script draws the map and moves the open card. -#}
  <div class="card rmap" data-rmap>
    <div class="rmap__stage">
      <canvas class="rmap__canvas" aria-hidden="true"></canvas>
      {%- for r in regionMap %}
      <a class="rmap__pin{% if loop.first %} is-on{% endif %}" href="{{ r.url }}" style="left:{{ r.x }}%;top:{{ r.y }}%" data-rmap-pin="{{ r.code }}"><span>{{ r.name }}</span></a>
      {%- endfor %}
      <div class="rmap__cards">
        {%- for r in regionMap %}
        <a class="rmap__card{% if loop.first %} is-on{% endif %}{% if r.flip %} rmap__card--flip{% endif %}" href="{{ r.url }}" style="--x:{{ r.x }}%;--y:{{ r.y }}%" data-rmap-card="{{ r.code }}">
          <b>{{ r.name }} <span>· {{ r.reg }}</span></b>
          {%- if r.top.length %}
          <span class="rmap__logos">{% for p in r.top %}<span class="rmap__logo{% if not p.logo %} rmap__logo--wm{% elif p.fit == 'contain' %} rmap__logo--contain{% endif %}"{% if p.logo and p.bg != '#FFFFFF' %} style="background:{{ p.bg }}"{% endif %}>{% if p.logo %}<img src="{{ p.logo }}" alt="{{ p.name }}" loading="lazy" decoding="async">{% elif p.wordmark %}<img src="{{ p.wordmark }}" alt="{{ p.name }}" loading="lazy" decoding="async">{% else %}<span>{{ p.name }}</span>{% endif %}</span>{% endfor %}</span>
          {%- endif %}
          <span class="rmap__more">See the ranking →</span>
        </a>
        {%- endfor %}
      </div>
    </div>
  </div>
  <script type="application/json" id="rmap-grid">{{ regionGrid | json | safe }}</script>
  <script>
  (function () {
    var box = document.querySelector('[data-rmap]'), data = document.getElementById('rmap-grid');
    if (!box || !data) return;
    var g = JSON.parse(data.textContent), cv = box.querySelector('canvas'), ctx = cv.getContext('2d');
    var pins = [].slice.call(box.querySelectorAll('[data-rmap-pin]')), cards = [].slice.call(box.querySelectorAll('[data-rmap-card]'));
    var codes = pins.map(function (p) { return p.getAttribute('data-rmap-pin'); });
    var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches, active = 0, paused = false, raf = 0, seen = false;
    box.classList.add('is-live');
    function show(i) {
      active = i;
      pins.forEach(function (p, j) { p.classList.toggle('is-on', j === i); });
      cards.forEach(function (c, j) { c.classList.toggle('is-on', j === i); });
    }
    function draw(now) {
      var dpr = Math.min(2, window.devicePixelRatio || 1), W = cv.clientWidth, H = cv.clientHeight;
      if (!W) return;
      if (cv.width !== Math.round(W * dpr)) { cv.width = Math.round(W * dpr); cv.height = Math.round(H * dpr); }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0); ctx.clearRect(0, 0, W, H);
      var cw = W / g.cols, ch = H / g.rows, s = Math.min(cw, ch) * 0.72, rr = s * 0.28, t = still ? 0 : now / 1000, on = codes[active];
      for (var r = 0; r < g.rows; r++) {
        var row = g.grid[r];
        for (var c = 0; c < g.cols; c++) {
          var v = row.charAt(c);
          if (v === '.') continue;
          if (v === '0') ctx.fillStyle = 'rgba(20,20,26,' + (0.1 + 0.07 * (0.5 + 0.5 * Math.sin(c * 0.09 - r * 0.05 + t * 0.6))) + ')';
          else if (v === on) ctx.fillStyle = 'rgba(91,43,217,' + (0.6 + 0.4 * (0.5 + 0.5 * Math.sin(c * 0.5 + r * 0.3 - t * 3.2))) + ')';
          else ctx.fillStyle = 'rgba(91,43,217,0.32)';
          ctx.beginPath();
          if (ctx.roundRect) ctx.roundRect(c * cw + (cw - s) / 2, r * ch + (ch - s) / 2, s, s, rr); else ctx.rect(c * cw + (cw - s) / 2, r * ch + (ch - s) / 2, s, s);
          ctx.fill();
        }
      }
    }
    function loop(now) { draw(now); if (!still && seen) raf = requestAnimationFrame(loop); }
    pins.forEach(function (p, i) {
      p.addEventListener('mouseenter', function () { paused = true; show(i); if (still) draw(0); });
      p.addEventListener('focus', function () { paused = true; show(i); if (still) draw(0); });
      p.addEventListener('mouseleave', function () { paused = false; });
    });
    cards.forEach(function (c) { c.addEventListener('mouseenter', function () { paused = true; }); c.addEventListener('mouseleave', function () { paused = false; }); });
    setInterval(function () { if (!paused && seen && !still) show((active + 1) % pins.length); }, 4200);
    // Draw only while the map is on screen
    new IntersectionObserver(function (es) {
      seen = es[0].isIntersecting; cancelAnimationFrame(raf);
      if (seen) { if (still) draw(0); else raf = requestAnimationFrame(loop); }
    }).observe(box);
    window.addEventListener('resize', function () { draw(performance.now()); });
  })();
  </script>
</section>

<section id="top-rated" class="container home-section" aria-labelledby="tr-h">
  <div class="section-head"><h2 id="tr-h" class="h-split h-split--xl">Top rated providers.<span>In true score order</span></h2><a class="btn btn--secondary btn--sm" href="/providers/">See all providers</a></div>
  <ol class="grid-4 top-grid">
    {%- for p in topRated %}
    <li>
      <a class="card top-card{% if loop.first %} top-card--first{% endif %}" href="/providers/{{ p.slug }}/" aria-label="{{ p.name }}: {{ p.score | score1 }} out of 5. Read review">
        <div class="top-card__head">{% if p.logo.wordmark %}<img src="{{ p.logo.wordmark }}" alt="" loading="lazy">{% else %}<b class="top-card__wm">{{ p.name }}</b>{% endif %}<span>{{ loop.index | pad2 }}</span></div>
        {%- if loop.first %}<span class="pill pill--dark self-start mt-12">◆ Editor's choice</span>{% endif %}
        <div class="top-card__name">{{ p.name }}</div>
        <div class="top-card__score" aria-hidden="true"><b>{{ p.score | score1 }}</b><small>/ 5</small></div>
        <div class="meter meter--sm" aria-hidden="true">{% for w in (p.score | meter) %}<span><i class="w-{{ w }}"></i></span>{% endfor %}</div>
        {%- if p.best_for %}<span class="pill self-start mt-16">Best for · {{ p.best_for }}</span>{% endif %}
        <p class="top-card__reason">{{ p.tagline }}</p>
        <span class="top-card__go">Read review →</span>
      </a>
    </li>
    {%- endfor %}
  </ol>
</section>

<section id="faq" class="container home-section home-uc" aria-labelledby="faq-h">
  <div class="home-uc__intro"><h2 id="faq-h" class="h-split h-split--xl">Questions<span>buyers ask.</span></h2></div>
  <div class="faq">{% for f in faqs %}<details{% if loop.first %} open{% endif %}><summary><h3>{{ f.q }}</h3></summary><p>{{ f.a }}</p></details>{% endfor %}</div>
</section>

<section id="for-providers" class="container home-section home-fp" aria-labelledby="fp-h">
  <h2 id="fp-h">For providers</h2>
  <a class="card fp-card" href="/placement-options/"><span><b>Claim your profile</b><small>Correct facts and add documentation</small></span><span aria-hidden="true">→</span></a>
</section>
</main>
<script src="/assets/js/slab-field.js" defer></script>
