{
  "name": "beverified",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf _site && eleventy",
    "serve": "eleventy --serve",
    "check": "node scripts/checks/content.mjs && node scripts/checks/links.mjs && node scripts/checks/quick-answers.mjs && node scripts/checks/placements.mjs",
    "check:quick-answers": "node scripts/checks/quick-answers.mjs",
    "gaps": "node scripts/checks/gaps.mjs",
    "inventory": "python3 scripts/inventory.py",
    "extract": "python3 scripts/extract.py",
    "check:strict": "node scripts/checks/content.mjs --strict && node scripts/checks/links.mjs --strict",
    "check:html": "python3 scripts/checks/html_audit.py --strict",
    "check:glossary": "node scripts/checks/glossary.mjs",
    "covers": "node scripts/covers.cjs",
    "region-map": "node scripts/region-map.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.2",
    "d3-geo": "^3.1.2",
    "js-yaml": "^4.1.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  }
}
